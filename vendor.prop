# SPDX-License-Identifier: Apache-2.0
#
# From the stock vendor/build.prop of the RTD1325 Android 14 SDK.

## Audio
ro.hardware.audio.primary=nontuner
persist.vendor.rtk.audio.hifi=1
persist.vendor.rtk.audio.hdmioutput=1
persist.vendor.rtk.audio.spdifoutput=0
persist.vendor.rtk.audio.in=9
persist.vendor.pcm.sync=18
persist.vendor.pcmoutch=8
persist.vendor.eac3.delay=2
persist.vendor.eac3.nonTunnel=70
persist.vendor.nonTunnel.delay=30
persist.vendor.compress.fw.lat=0
persist.sys.rtk.audio.hdmioutput=1
persist.sys.rtk.audio.spdifoutput=0
persist.sys.rtk.audio.playbackeffect=off
persist.sys.rtk.audio.forcesdaudio=false
persist.sys.rtk.audio.mute_timeout=0

## Bluetooth
ro.bt.bdaddr_path=/vendor/etc/bluetooth/dummy_addr
bluetooth.device.class_of_device=44,4,32
persist.vendor.rtkbt.bdaddr_path=none
persist.vendor.bluetooth.rtkcoex=true
persist.vendor.bluetooth.prefferedrole=master
persist.vendor.rtkbtadvdisable=false
persist.vendor.btsnoop.enable=false
persist.vendor.btsnoopsavelog=false
# Stock value. The HAL still loads libbt-vendor.so (Realtek) when
# wifi_auto_insmod found a Realtek combo chip, libbt-vendor-seekwave.so is for
# the SWT6621S boards.
persist.vendor.bluetooth_vendor=seekwave
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bap.broadcast.assist.enabled=true
bluetooth.profile.bap.unicast.client.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.csip.set_coordinator.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hap.client.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.mcp.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.vcp.controller.enabled=true

## Codec2 / OMX
debug.stagefright.c2-poolmask=0xf50000
debug.stagefright.c2inputsurface=-1
debug.stagefright.omx_default_rank=1024
vendor.omx.hevc_performance_mode=0
persist.vendor.rtk.omx_cpu_ctrl_disable=1
persist.vendor.rtk.pro.playback=1
persist.vendor.rtk.video.maxAcqCnt=3
persist.sys.media.avsync=true
ro.vendor.rtk.video.spec=4K
ro.vendor.rtk.dovi.support=1

## Dalvik (4 GiB)
dalvik.vm.heapsize=384m
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapstartsize=8m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=8m

## DRM / HDCP
drm.service.enabled=true
media.mediadrmservice.enable=true
ro.vendor.config.enablehdcp=true
ro.vendor.rtk.hdcp.storage=/data/vendor/hdcp
persist.vendor.rtk.drm.hdcp=0

## FRP
ro.frp.pst=/dev/block/by-name/frp

## Graphics
ro.hardware.egl=mali
ro.hardware.hwcomposer=drm_rtk
ro.opengles.version=196610
vendor.hwc.drm.device=/dev/dri/card0
persist.vendor.gralloc.afbc.fb=1
persist.vendor.gralloc.afbc.texture=1
debug.sf.enable_gl_backpressure=1
service.sf.prime_shader_cache=0
ro.vendor.arm.gralloc.no_afbc_usage_flags=0x2000000000000000
ro.vendor.arm.gralloc.no_afbc_usage_mask=0x6000000000000000
ro.vendor.arm.gralloc.force_back_buffer_usage_flags=0x40000000000000
ro.vendor.arm.gralloc.force_back_buffer_usage_mask=0x40000000000000
ro.vendor.arm.gralloc.shared_access_usage_flags=0x1000000000000000
ro.vendor.arm.gralloc.shared_access_usage_mask=0x5000000000000000
ro.vendor.arm.gralloc.afrc_rgba_usage_flags=0x5000000000000000,0x6000000000000000,0x4000000000000000
ro.vendor.arm.gralloc.afrc_rgba_usage_mask=0x7000000000000000
ro.vendor.arm.gralloc.afrc_luma_usage_flags=0x5000000000000000,0x6000000000000000,0x4000000000000000
ro.vendor.arm.gralloc.afrc_luma_usage_mask=0x7000000000000000
ro.vendor.arm.gralloc.afrc_chroma_usage_flags=0x100000000000000,0x80000000000000,0x180000000000000
ro.vendor.arm.gralloc.afrc_chroma_usage_mask=0x180000000000000

## HDMI / CEC
ro.hdmi.cec_device_types=playback_device
ro.hdmi.cec.source.playback_device_action_on_routing_control=wake_up_and_send_active_source
ro.vendor.hdmi.cec_vendor_id=32640
persist.vendor.cec.ignore=0
persist.vendor.cec.power.ack.enable=1
persist.sys.hdmi.keep_awake=false
persist.sys.rtk.cec.wakeup=1
persist.sys.rtk.hdmi.ignoreplugout=false
persist.sys.rtk.hdmirx.version=1.4
persist.sys.rtk.video.auto1080p24=true
persist.sys.rtk.video.auto2997hz=false
persist.vendor.rtk.hdmi.cecpoweronfromtv=1
persist.vendor.rtk.hdmi.auto.fps=60
persist.vendor.rtk.hdmi.fps.match.p=1
persist.vendor.rtk.hdmi.auto.policy=1
persist.vendor.rtk.hdmi.apply.hdr=1
persist.vendor.rtk.hdmi.nohdcp.vic=16
persist.vendor.rtk.block.hdr=1

## Logging
ro.logd.size=2M

## Performance
persist.sys.rtk.performancemode=0

## Storage
persist.sys.rtk.vold.trymount=1
persist.sys.rtk.vold.checkvolume=0
persist.sys.rtk.vold.formatonerror=0

## SurfaceFlinger
ro.surface_flinger.vsync_event_phase_offset_ns=1000000
ro.surface_flinger.vsync_sf_event_phase_offset_ns=1000000
ro.surface_flinger.use_context_priority=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.has_wide_color_display=false
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.start_graphics_allocator_service=false
ro.surface_flinger.primary_display_orientation=ORIENTATION_0
ro.surface_flinger.use_color_management=false
ro.surface_flinger.protected_contents=false
ro.surface_flinger.max_graphics_width=1920
ro.surface_flinger.max_graphics_height=1080
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.update_device_product_info_on_hotplug_reconnect=1

## Wi-Fi
wifi.interface=wlan0
wifi.direct.interface=p2p0
wifi.concurrent.interface=p2p-dev-wlan0

