<!-- What the stock blobs need from the framework. Stock also listed
     android.frameworks.sensorservice@1.0 and android.hidl.token@1.0, which
     no blob here uses; hidl memory is used by the audio effects HAL and OMX. -->
<compatibility-matrix version="2.0" type="device">
    <hal format="hidl" optional="false">
        <name>android.hidl.manager</name>
        <version>1.0</version>
        <interface>
            <name>IServiceManager</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="false">
        <name>android.hidl.allocator</name>
        <version>1.0</version>
        <interface>
            <name>IAllocator</name>
            <instance>ashmem</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="false">
        <name>android.hidl.memory</name>
        <version>1.0</version>
        <interface>
            <name>IMapper</name>
            <instance>ashmem</instance>
        </interface>
    </hal>
</compatibility-matrix>
