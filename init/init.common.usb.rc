on early-init
    write /sys/module/usbcore/parameters/quirks "0781:55b1:k"

on fs
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    mount configfs none /config
    mkdir /config/usb_gadget/g1
    mkdir /config/usb_gadget/g1/configs/b.1
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/mtp.gs0
    mkdir /config/usb_gadget/g1/functions/rndis.gs4
    mkdir /config/usb_gadget/g1/strings/0x409
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    # Select configfs before the normal-boot USB property triggers run.
    setprop sys.usb.configfs 1

on property:sys.usb.config=mtp
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee1
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer "Realtek"
    write /config/usb_gadget/g1/strings/0x409/product "FunctionFS gadget (mtp)"
    write /config/usb_gadget/g1/os_desc/use 1
    setprop sys.usb.configfs 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp,adb
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4EE7
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer "Realtek"
    write /config/usb_gadget/g1/strings/0x409/product "FunctionFS gadget (mtp, adb)"
    write /config/usb_gadget/g1/os_desc/use 1
    setprop sys.usb.configfs 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=rndis
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee3
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer "Realtek"
    write /config/usb_gadget/g1/strings/0x409/product "FunctionFS gadget (rndis)"
    write /config/usb_gadget/g1/os_desc/use 1
    setprop sys.usb.configfs 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=adb
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4EE7
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer "Realtek"
    write /config/usb_gadget/g1/strings/0x409/product "FunctionFS gadget (adb)"
    write /config/usb_gadget/g1/os_desc/use 1
    # adbd sets sys.usb.ffs.ready after opening its FunctionFS endpoints.
    setprop sys.usb.configfs 1

on property:sys.usb.config=rndis,adb
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee4
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer "Realtek"
    write /config/usb_gadget/g1/strings/0x409/product "FunctionFS gadget (rndis, adb)"
    write /config/usb_gadget/g1/os_desc/use 1
    start adbd
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=ptp
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee5
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer "Realtek"
    write /config/usb_gadget/g1/strings/0x409/product "FunctionFS gadget (ptp)"
    write /config/usb_gadget/g1/os_desc/use 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=ptp,adb
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee6
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer "Realtek"
    write /config/usb_gadget/g1/strings/0x409/product "FunctionFS gadget (ptp, adb)"
    write /config/usb_gadget/g1/os_desc/use 1
    start adbd
    setprop sys.usb.state ${sys.usb.config}
