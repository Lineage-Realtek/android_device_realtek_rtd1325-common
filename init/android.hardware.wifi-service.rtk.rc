# Stock android.hardware.wifi-service.rc, for the stock HAL installed under
# another name so that it does not clash with the AOSP module.
service vendor.wifi_hal_legacy /vendor/bin/hw/android.hardware.wifi-service.rtk
    interface aidl android.hardware.wifi.IWifi/default
    class hal
    capabilities NET_ADMIN NET_RAW SYS_MODULE
    user wifi
    group wifi gps
