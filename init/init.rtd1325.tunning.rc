on init
    # keep minimum free memory
    write /proc/sys/vm/min_free_kbytes 10240

on fs

    # zram
    write /sys/block/zram0/comp_algorithm lzo-rle
    write /proc/sys/vm/page-cluster 0
    swapon_all /vendor/etc/fstab.zram.50p
	
on property:sys.boot_completed=1
    write /proc/sys/vm/min_free_kbytes 12288
    write /proc/sys/vm/watermark_scale_factor 30

    # Adjust swappiness based on customer env
    # write /proc/sys/vm/swappiness 30

    write /sys/block/mmcblk0/queue/nr_requests 128
    write /sys/block/mmcblk0/queue/read_ahead_kb 128
    write /sys/block/dm-0/queue/read_ahead_kb 128
    write /sys/block/dm-1/queue/read_ahead_kb 128
    write /sys/block/dm-2/queue/read_ahead_kb 128
    write /sys/block/dm-3/queue/read_ahead_kb 128
    write /sys/block/dm-4/queue/read_ahead_kb 128
    write /sys/block/dm-5/queue/read_ahead_kb 128
    write /sys/block/dm-6/queue/read_ahead_kb 128
    write /sys/block/dm-7/queue/read_ahead_kb 128
    write /sys/block/dm-8/queue/read_ahead_kb 128
