# Stock android.hardware.bluetooth@1.1-service.rc, for the stock HAL installed under another name
# so that it does not clash with the AOSP module.
service vendor.bluetooth-1-1 /vendor/bin/hw/android.hardware.bluetooth@1.1-service.rtk
    interface android.hardware.bluetooth@1.1::IBluetoothHci default
    interface android.hardware.bluetooth@1.0::IBluetoothHci default
    class hal
    capabilities BLOCK_SUSPEND NET_ADMIN SYS_NICE
    user bluetooth
    group bluetooth
    task_profiles HighPerformance

