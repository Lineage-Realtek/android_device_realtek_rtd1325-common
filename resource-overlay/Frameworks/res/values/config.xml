<!-- Values from the stock RtkCommonFrameworkOverlay and RTKAOSPFramworkOverlay -->
<resources>
    <!-- Wi-Fi, Bluetooth PAN and Ethernet, no modem -->
    <string-array name="networkAttributes" translatable="false">
        <item>"wifi,1,1,1,-1,true"</item>
        <item>"bluetooth,7,7,3,-1,true"</item>
        <item>"ethernet,9,9,9,-1,true"</item>
    </string-array>

    <string-array name="radioAttributes" translatable="false">
        <item>"1,1"</item>
        <item>"7,1"</item>
        <item>"9,1"</item>
    </string-array>

    <bool name="config_sms_capable">false</bool>
    <bool name="config_voice_capable">false</bool>

    <bool name="config_bluetooth_le_peripheral_mode_supported">true</bool>
    <bool name="config_hearing_aid_profile_supported">true</bool>

    <!-- HDMI CEC -->
    <bool name="config_cecPowerControlModeBroadcast_default">false</bool>
    <bool name="config_cecPowerControlModeTvAndAudioSystem_default">true</bool>
    <bool name="config_cecVolumeControlModeDisabled_default">true</bool>
    <bool name="config_cecVolumeControlModeEnabled_default">false</bool>

    <bool name="config_dreamsActivatedOnSleepByDefault">true</bool>
    <bool name="config_single_volume">true</bool>
    <bool name="config_supportsSeamlessRefreshRateSwitching">true</bool>
    <bool name="config_supportsSystemDecorsOnSecondaryDisplays">false</bool>

    <!-- Short press of the remote power key goes to sleep, long press shows the menu -->
    <integer name="config_longPressOnPowerBehavior">2</integer>

    <!-- Keep the UI at 1080p on 4K outputs -->
    <integer name="config_maxUiWidth">1920</integer>
</resources>
